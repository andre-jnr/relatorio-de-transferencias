# Copie para .env e preencha. O .env nunca vai para o git nem para o navegador.

# Porta do sistema (tabela de orientacoes-projetos-ia.md)
PORT=3008

# Lojas emissoras consultadas, separadas por vírgula (slugs de config/unidades.json).
# Disponíveis: parque_dez, ponta_negra, morada_do_sol, monte_das_oliveiras, flores, cd
LOJAS=parque_dez,ponta_negra,morada_do_sol,monte_das_oliveiras,flores

# Login do SQL Server (o mesmo para todas as lojas)
DB_USUARIO=
DB_SENHA=

# Login próprio do servidor da Flores
FLORES_DB_USUARIO=
FLORES_DB_SENHA=

# Por quanto tempo reaproveitar a última consulta de cada loja/mês (minutos)
CACHE_MINUTOS=15
